<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以上的备份规则。文档、笔记和 API Key 都在 WebView 的 IndexedDB 里，只留在本机：
  云备份和换机直传都不带任何数据，换设备用 App 里的「导出备份 / 恢复备份」。
  allowBackup="false" 管不到换机直传，所以还需要这份规则。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
